# ─────────── Server ───────────
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
BODY_LIMIT=1mb
# Bật khi chạy sau nginx / load balancer (để req.ip đúng cho rate limit)
TRUST_PROXY=false

# ─────────── CORS ───────────
# Nhiều origin: CORS_ORIGINS=https://boostcareer.site,https://www.boostcareer.site
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# ─────────── Cookie ───────────
# sameSite=none BẮT BUỘC secure=true (dùng khi FE và BE khác domain)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.boostcareer.site
COOKIE_ACCESS_MAX_AGE_MS=3600000
COOKIE_REFRESH_MAX_AGE_MS=604800000

# ─────────── JWT (BẮT BUỘC) ───────────
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES=3600
JWT_REFRESH_EXPIRES=604800

# ─────────── MySQL (BẮT BUỘC: HOST, USER, DB) ───────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=boostcareer
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUEUE_LIMIT=0
MYSQL_CONNECT_TIMEOUT=20000

# ─────────── AWS S3 ───────────
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─────────── Upload ───────────
UPLOAD_IMAGE_MAX_BYTES=5242880
UPLOAD_CV_MAX_BYTES=10485760
# Bật SAU KHI mọi read-path của CV đã dùng presigned URL (Phase 1C)
S3_CV_PRIVATE=false
S3_SIGNED_URL_TTL=900

# ─────────── Security ───────────
PASSWORD_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=10

# ─────────── AI provider ───────────
AI_PROVIDER=openrouter
AI_EMBEDDING_PROVIDER=openrouter
AI_EMBEDDING_MODEL=
AI_CHAT_PROVIDER=openrouter
AI_CHAT_MODEL=
AI_CHAT_MAX_TOKENS=1024
AI_PROVIDER_TIMEOUT_MS=30000
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=BoostCareer
OPENAI_API_KEY=
